{
  "name": "masters-wheel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "app:dev": "tauri dev",
    "app:build": "CARGO_TARGET_DIR=\"$PWD/src-tauri/target\" tauri build",
    "app:open": "node scripts/app-bundle.mjs open",
    "app:install": "node scripts/app-bundle.mjs install",
    "app:start": "npm run app:build && node scripts/app-bundle.mjs launch",
    "test": "node --test 'src/lib/**/*.test.mjs'",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:all": "npm test && npm run test:rust"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5"
  }
}
