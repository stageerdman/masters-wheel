{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "records",
  "description": "Local records backend: fs + dialog access scoped to the Master's Circle storage root only.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$DOCUMENT/Master's Circle" }, { "path": "$DOCUMENT/Master's Circle/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$DOCUMENT/Master's Circle" }, { "path": "$DOCUMENT/Master's Circle/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$DOCUMENT/Master's Circle" }, { "path": "$DOCUMENT/Master's Circle/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$DOCUMENT/Master's Circle" }, { "path": "$DOCUMENT/Master's Circle/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$DOCUMENT/Master's Circle" }, { "path": "$DOCUMENT/Master's Circle/**" }]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [{ "path": "$DOCUMENT/Master's Circle" }, { "path": "$DOCUMENT/Master's Circle/**" }]
    }
  ]
}
