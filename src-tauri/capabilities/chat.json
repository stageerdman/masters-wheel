{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chat",
  "description": "Chat session persistence: fs access scoped to the app's own chats data folder only (not ~/Documents — see src/lib/chat/storage.ts).",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/chats" }, { "path": "$APPDATA/chats/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA/chats" }, { "path": "$APPDATA/chats/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/chats" }, { "path": "$APPDATA/chats/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/chats" }, { "path": "$APPDATA/chats/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/chats" }, { "path": "$APPDATA/chats/**" }]
    }
  ]
}
