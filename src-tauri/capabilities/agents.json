{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "agents",
  "description": "Agent persistence: fs access scoped to the app's own agents data folder only (not ~/Documents — see src/lib/agents/storage.ts).",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/agents" }, { "path": "$APPDATA/agents/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA/agents" }, { "path": "$APPDATA/agents/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/agents" }, { "path": "$APPDATA/agents/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/agents" }, { "path": "$APPDATA/agents/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/agents" }, { "path": "$APPDATA/agents/**" }]
    }
  ]
}
